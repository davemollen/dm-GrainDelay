@prefix pg: <http://lv2plug.in/ns/ext/port-groups#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix epp:   <http://lv2plug.in/ns/ext/port-props#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .

<https://github.com/davemollen/dm-GrainDelay>
	a lv2:Plugin , lv2:PitchPlugin , mod:DelayPlugin ;
	lv2:project <http://lv2plug.in/ns/lv2> ;
	doap:name "dm-GrainDelay" ;
	doap:license "GPLv3" ;
	doap:maintainer [
		foaf:name "Dave Mollen" ;
		foaf:homepage <https://github.com/davemollen/dm-GrainDelay> ;
	] ;
	mod:brand "DM" ;
	mod:label "Grain Delay" ;
	rdfs:comment """
A granular delay effect.
""" ;
	lv2:optionalFeature lv2:hardRTCapable ;
	lv2:minorVersion 0 ;
	lv2:microVersion 2 ;
	lv2:port [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 0 ;
		lv2:symbol "spray" ;
		pg:group <https://github.com/davemollen/dm-GrainDelay#group_grains> ;
		lv2:name "Spray" ;
		lv2:portProperty epp:logarithmic;
		lv2:default 2.0 ;
		lv2:minimum 1.0 ;
		lv2:maximum 500.0 ;
		units:unit units:ms
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 1 ;
		lv2:symbol "frequency" ;
		pg:group <https://github.com/davemollen/dm-GrainDelay#group_grains> ;
		lv2:name "Frequency" ;
		lv2:portProperty epp:logarithmic , mod:tempoRelatedDynamicScalePoints ;
		lv2:default 5.0 ;
		lv2:minimum 1.0 ;
		lv2:maximum 150.0 ;
		units:unit units:hz
	] , [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 2 ;
		lv2:symbol "pitch" ;
		pg:group <https://github.com/davemollen/dm-GrainDelay#group_grains> ;
		lv2:name "Pitch" ;
		lv2:default 12.0 ;
		lv2:minimum -24.0 ;
		lv2:maximum 24.0 ;
		units:unit units:semitone12TET
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 3 ;
		lv2:symbol "drift" ;
		pg:group <https://github.com/davemollen/dm-GrainDelay#group_grains> ;
		lv2:name "Drift" ;
		lv2:default 0.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 100.0 ;
		units:unit units:pc
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 4 ;
		lv2:symbol "reverse" ;
		pg:group <https://github.com/davemollen/dm-GrainDelay#group_grains> ;
		lv2:name "Reverse" ;
		lv2:default 0.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 100.0 ;
		units:unit units:pc
	] , [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 5;
		lv2:symbol "time" ;
		pg:group <https://github.com/davemollen/dm-GrainDelay#group_delay> ;
		lv2:name "Time" ;
		lv2:portProperty epp:logarithmic , mod:tempoRelatedDynamicScalePoints ;
		lv2:default 1.0 ;
		lv2:minimum 1.0 ;
		lv2:maximum 5000.0 ;
		units:unit units:ms
	] , [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 6 ;
		lv2:symbol "feedback" ;
		pg:group <https://github.com/davemollen/dm-GrainDelay#group_delay> ;
		lv2:name "Feedback" ;
		lv2:default 50.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 150.0 ;
		units:unit units:pc
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 7 ;
		lv2:symbol "filter" ;
		pg:group <https://github.com/davemollen/dm-GrainDelay#group_delay> ;
		lv2:name "Filter" ;
		lv2:portProperty epp:logarithmic ;
		lv2:default 5000.0 ;
		lv2:minimum 20.0 ;
		lv2:maximum 11025.0 ;
		units:unit units:hz
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 8 ;
		lv2:symbol "spread" ;
		pg:group <https://github.com/davemollen/dm-GrainDelay#group_output> ;
		lv2:name "Spread" ;
		lv2:default 0.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 100.0 ;
		units:unit units:pc
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 9 ;
		lv2:symbol "mix" ;
		pg:group <https://github.com/davemollen/dm-GrainDelay#group_output> ;
		lv2:name "Mix" ;
		lv2:default 50.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 100.0 ;
		units:unit units:pc
	], [
		a lv2:AudioPort, lv2:InputPort ;
		lv2:index 10 ;
		lv2:symbol "in" ;
		lv2:name "In"
	] , [
		a lv2:AudioPort, lv2:OutputPort ;
		lv2:index 11 ;
		lv2:symbol "out_left" ;
		lv2:name "Out left"
	] , [
		a lv2:AudioPort, lv2:OutputPort ;
		lv2:index 12 ;
		lv2:symbol "out_right" ;
		lv2:name "Out right"
	] .

# Port groups (MOD OS 1.14 settings panel), added 2026-10
<https://github.com/davemollen/dm-GrainDelay#group_grains>
	a pg:InputGroup ;
	lv2:symbol "grains" ;
	lv2:name "Grains" ;
	lv2:index 0 .

<https://github.com/davemollen/dm-GrainDelay#group_delay>
	a pg:InputGroup ;
	lv2:symbol "delay" ;
	lv2:name "Delay" ;
	lv2:index 1 .

<https://github.com/davemollen/dm-GrainDelay#group_output>
	a pg:InputGroup ;
	lv2:symbol "output" ;
	lv2:name "Output" ;
	lv2:index 2 .
